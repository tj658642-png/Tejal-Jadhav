{
  "name": "AI Council",
  "user": "ubuntu",
  "install": "bash .cursor/scripts/cloud-agent-install.sh",
  "start": "bash .cursor/scripts/cloud-agent-start.sh",
  "ports": [
    {
      "name": "AI Council (UI + API)",
      "port": 4000
    }
  ],
  "terminals": [
    {
      "name": "app",
      "command": "bash .cursor/scripts/start-cloud-app.sh",
      "description": "Serves the built React app and API together on port 4000."
    }
  ]
}
