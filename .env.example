# Client (Vite — never put server secrets here)
# Supabase project URL (Settings → API)
VITE_SUPABASE_URL=
# Publishable/anon key (safe for browser; e.g. sb_publishable_… or legacy anon JWT)
VITE_SUPABASE_ANON_KEY=
# Leave empty for Vite proxy (/api → port 4000). Only set if API is on another origin.
VITE_API_URL=
# Allow hackathon demo without login while Supabase keys are present
VITE_ENABLE_GUEST_DEMO=true

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

MAX_AGENTS=4
MAX_TOKENS=2000
REQUEST_TIMEOUT_MS=30000
MAX_FILE_SIZE_MB=10
